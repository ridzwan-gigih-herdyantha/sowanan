NEXT_PUBLIC_SITE_URL=https://sowanan.com

# Supabase (region Singapore). Tanpa ini, homepage tetap jalan dengan DEFAULT_SETTINGS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket publik untuk foto, video, dan musik undangan
NEXT_PUBLIC_STORAGE_BUCKET=sowanan-storage

# Meta Pixel + verifikasi domain (PRD 2.6)
NEXT_PUBLIC_META_PIXEL_ID=
META_DOMAIN_VERIFICATION=

# Google Search Console (isi konten meta tag verifikasi)
GOOGLE_SITE_VERIFICATION=

# Hanya untuk scripts/create-admin.ts
ADMIN_EMAIL=
ADMIN_PASSWORD=
